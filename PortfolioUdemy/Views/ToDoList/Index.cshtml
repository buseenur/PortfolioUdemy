@model List<ToDoList>
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Layout/Index.cshtml";
}
@{
    int sayac = 0;
}
<div class="content">
    <div class="container-fluid">
        <h4 class="page-title">Yapılacaklar</h4>
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <div class="card-title">Yapılacaklar Listesi</div>
                    </div>
                    <div class="card-body">
                        <div class="card-sub">
                            Yapılacaklar ile ilgili işlemleri aşağıdaki panelden yapabilirsiniz :
                        </div>
                        <table class="table mt-3">
                            <thead>
                                <tr>
                                    <th scope="col">#</th>
                                    <th scope="col">İçerik</th>
                                    <th scope="col">Tarih</th>
                                    <th scope="col">Durum</th>
                                    <th scope="col">Sil</th>
                                    <th scope="col">Güncelle</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    sayac++;
                                    <tr>
                                        <td>@sayac</td>
                                        <td>@item.Title</td>
                                        <td>@item.Date</td>
                                        @if (item.Status == true)
                                        {
                                            <td><a href="/ToDoList/ChangeIsReadFalse/@item.ToDoListId" class="btn btn-outline-warning btn--medium">Yapıldı</a></td>
                                        }
                                        else
                                        {
                                            <td><a href="/ToDoList/ChangeIsReadTrue/@item.ToDoListId" class="btn btn-outline-secondary btn--medium">Yapılmadı</a></td>
                                        }
                                        <td><a href="/ToDoList/DeleteToDo/@item.ToDoListId" class="btn btn-outline-danger btn--medium">Sil</a></td>
                                        <td><a href="/ToDoList/UpdateToDo/@item.ToDoListId" class="btn btn-outline-success btn--medium">Güncelle</a></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        <td><a href="/ToDoList/CreateToDo/" class="btn btn-outline-primary btn--medium">Yeni Yapılacak İşlem Girişi</a></td>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


